{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.foc_learning_repo/schemas/fact_registry.schema.json",
  "title": "FOC Learning Fact Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id",
    "claim",
    "source_path",
    "authority_level",
    "risk_level",
    "status",
    "allowed_actions",
    "forbidden_actions",
    "last_reviewed",
    "notes"
  ],
  "properties": {
    "fact_id": {
      "type": "string",
      "pattern": "^FACT-[0-9]{4}$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "enum": [
        "AGENTS.md",
        "CURRENT_STATUS.md",
        "docs/00_project_truth/project_context.md",
        "docs/00_project_truth/internet_verification_rules.md"
      ]
    },
    "authority_level": {
      "type": "string",
      "enum": [
        "highest_project_truth",
        "project_truth_rule",
        "current_status",
        "repo_agent_rule"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "const": "active"
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
